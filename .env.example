# 이 파일을 복사해 .env 로 만들어 사용 (.env는 git에 올리지 않음)
DB_NAME=independence
DB_URL=jdbc:mysql://localhost:3306/independence?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=1234
REDIS_HOST=localhost
REDIS_PORT=6379

# 외부 API 키 (담당자가 발급 후 채울 것)
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
KAKAO_REST_API_KEY=
MOLIT_SERVICE_KEY=
POLICY_API_KEY=

# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
